<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RediscoveryManager.GUI"
             xmlns:converter="clr-namespace:RediscoveryManager.GUI.Converter"
             x:Class="RediscoveryManager.GUI.App">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
      <converter:ConnectionStateColorConverter x:Key="connectionStateColor"/>
      <converter:IntNotMinusStringValueConverter x:Key="intNotMinusString"/>
    </Application.Resources>

  <Application.Styles>
      <StyleInclude Source="avares://Avalonia.Themes.Default/DefaultTheme.xaml"/>
        <StyleInclude Source="avares://Avalonia.Themes.Default/Accents/BaseLight.xaml"/>
    </Application.Styles>
</Application>
