<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RediscoveryManager.GUI.Pages.Logger">
  <DataGrid Name="dataGrid1" Margin="12" CanUserResizeColumns="True" CanUserReorderColumns="True">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Sid" Binding="{Binding Sid}" Width="4*" />
      <DataGridTextColumn Header="Time" Binding="{Binding Time, Mode=OneWay, Converter={StaticResource dateToTimeOnlyConverter}}" Width="4*" />
      <DataGridTextColumn Header="LogLevel" Binding="{Binding LogLevel}" Width="3*" />
      <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="4*" />
      <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="5*" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
