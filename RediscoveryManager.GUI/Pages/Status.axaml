<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RediscoveryManager.GUI.Pages.Status">
  <StackPanel Margin="15">
    <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 15">
      <Button Command="{Binding Connect}" IsEnabled="{Binding CanConnect}" Foreground="White" Background="Green" Margin="0, 0, 5, 0">Connect</Button>
      <Button Command="{Binding Disconnect}" IsEnabled="{Binding CanDisconnect}" Foreground="White" Background="Red" Margin="0, 0, 5, 0">Disconnect</Button>
      <Button Command="{Binding EditConnection}">Edit connection</Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Margin="0, 0, 15, 0">Connection State:</TextBlock>
      <TextBlock FontWeight="Bold" Foreground="{Binding State, Converter={StaticResource connectionStateColor}}" Text="{Binding State}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
