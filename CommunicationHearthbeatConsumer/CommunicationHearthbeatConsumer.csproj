<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.12.2" />
    <PackageReference Include="Grpc.Core" Version="2.29.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.29.0" />
    <PackageReference Include="Grpc.Tools" Version="2.29.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunicationBase\CommunicationBase.csproj" />
    <ProjectReference Include="..\SharedCoreModels\SharedCoreModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Proto\hearthbeat.proto" GrpcServices="Client" Link="Protos\hearthbeat.proto" />
  </ItemGroup>

</Project>
