<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppControlPanel"
             xmlns:converter="clr-namespace:AppControlPanel.Converter"
             x:Class="AppControlPanel.App">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <StyleInclude Source="avares://Avalonia.Themes.Default/DefaultTheme.xaml"/>
        <StyleInclude Source="avares://Avalonia.Themes.Default/Accents/BaseLight.xaml"/>
    </Application.Styles>

    <Application.Resources>
      <converter:LaunchStateBackColorConverter x:Key="LaunchBackColor"/>
      <converter:LaunchStateForeColorConverter x:Key="LaunchForeColor"/>
    </Application.Resources>
</Application>
