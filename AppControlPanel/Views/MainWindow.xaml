<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Rediscovery.Client.App.ControlPanel.ViewModels;assembly=Rediscovery.Client.App.ControlPanel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        Width="400" Height="250"
        MinWidth="400" MinHeight="250"
        x:Class="Rediscovery.Client.App.ControlPanel.Views.MainWindow"
        Icon="/Assets/rediscovery.ico"
        Title="Rediscovery Application Control Panel">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="10, 10" Grid.Row="0">
      <CheckBox Margin="10, 10" Name="topMostCheck">Top most</CheckBox>
      <Button Margin="10, 10" Foreground="White" Background="Blue" Command="{Binding OpenSettings}">Open Settings File</Button>  
    </StackPanel>
    <ItemsControl Grid.Row="1" Items="{Binding Apps}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="1*"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="10,0" Text="{Binding AppModel.Name}" TextAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Foreground="{Binding AppLaunchState, Converter={StaticResource LaunchForeColor}}"
                    Background="{Binding AppLaunchState, Converter={StaticResource LaunchBackColor}}"
                    IsEnabled="{Binding !IsRunning}"
                    Command="{Binding StartItem}" CommandParameter="{Binding .}">Start</Button>
              <Button Foreground="White"
                      Background="DarkRed"
                      IsEnabled="{Binding IsRunning}"
                      Command="{Binding StopItem}" CommandParameter="{Binding .}">Stop</Button>
            </StackPanel>
            <TextBlock Grid.Column="2" Margin="10,0" Text="{Binding AppLaunchState, Converter={StaticResource LaunchTextColor}}" TextAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <TextBlock Margin="10,0,0,0" Text="Process Id:" TextAlignment="Left" VerticalAlignment="Center"/>
              <TextBlock Margin="5,0,0,0" Text="{Binding ProcessId}" TextAlignment="Center" VerticalAlignment="Center"/>  
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
