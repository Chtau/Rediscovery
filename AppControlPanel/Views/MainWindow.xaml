<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppControlPanel.ViewModels;assembly=AppControlPanel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="250"
        Width="350" Height="250"
        x:Class="AppControlPanel.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="AppControlPanel">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ItemsControl Items="{Binding Apps}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="10,0" Text="{Binding Name}" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Foreground="White" Background="Green" Command="{Binding $parent[Window].DataContext.StartItem}" CommandParameter="{Binding .}">Start</Button>
            <!--Command="{Binding $parent[UserControl].DataContext.StartItem}" CommandParameter="{Binding .}"-->
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

</Window>
