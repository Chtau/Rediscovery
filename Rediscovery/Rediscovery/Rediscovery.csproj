    <PackageReference Include="sqlite-net-pcl" Version="1.6.292" />
    <PackageReference Include="Xamarin.Forms" Version="4.4.0.991477" />  
    <PackageReference Include="Xamarin.Essentials" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PluginFeature\PluginFeature.csproj" />
    <ProjectReference Include="..\..\SharedCoreModels\SharedCoreModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Features\DesktopFeatures\FeaturePage\TerminalPage\TerminalFeaturePage.xaml.cs">
