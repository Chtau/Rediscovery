<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Rediscovery.Features.DesktopConfiguration.DiscoveryDevicesPage"
             Title="Discover devices in the Network">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Clicked="Back_Clicked" Icon="close_white.png"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0" Margin="15">
                <ListView x:Name="DevicesFoundControl" 
                ItemsSource="{Binding FoundDevices}"
                VerticalOptions="FillAndExpand"
                 HasUnevenRows="true"
                 ItemSelected="DevicesFoundControl_ItemSelected"
                 CachingStrategy="RecycleElement">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame BorderColor="Orange" CornerRadius="10" HasShadow="True" Padding="5" Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="computer_line.png"></Image>
                                        <Grid Grid.Column="1" Padding="10, 0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding DesktopName}" LineBreakMode="NoWrap" Style="{DynamicResource ListItemTextStyle}" FontSize="16" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding IPAddress}" LineBreakMode="NoWrap" Style="{DynamicResource ListItemDetailTextStyle}" FontSize="13" VerticalTextAlignment="Center"/>
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DesktopOS}" LineBreakMode="NoWrap" Style="{DynamicResource ListItemDetailTextStyle}" FontSize="13" VerticalTextAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
            <StackLayout Grid.Row="1" Margin="5">
                <!--Icon="focus_white.png"-->
                <Button    
                    IsVisible="{Binding IsDiscoveryRunning, Converter={StaticResource reverseBoolConverter}}"
                    Text="Start device discovery"
                    Padding="5"
                    Command="{Binding DiscoveryCommand}"
                    Style="{StaticResource LargeFlexButton}"/>
                <!--Icon="stop_circle.png"-->
                <Button                    
                    IsVisible="{Binding IsDiscoveryRunning}"
                    Text="Stop device discovery"
                    Padding="5"
                    Command="{Binding StopDiscoveryCommand}"
                    Style="{StaticResource LargeFlexButton}"/>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>