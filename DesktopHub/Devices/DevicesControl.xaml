<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:Local="clr-namespace:DesktopHub.Devices;assembly=DesktopHub"
             x:Class="DesktopHub.Devices.DevicesControl">
  <Grid RowDefinitions="*, Auto">
    <ListBox Grid.Row="0" Items="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding $parent[UserControl].DataContext.RemoveItem}" CommandParameter="{Binding .}">Remove</Button>
            <TextBlock Margin="10,0" Text="{Binding Name}" TextAlignment="Center" VerticalAlignment="Center"/>
            <CheckBox Margin="10,0" IsChecked="{Binding AllowAccess}" IsEnabled="False"></CheckBox>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
