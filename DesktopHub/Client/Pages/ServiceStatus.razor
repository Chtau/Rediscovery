@page "/servicestatus"
@inject CommunicationAuthenticationConsumer.IGreetingConsumerService greetingConsumer
@inject CommunicationAuthenticationConsumer.IAuthenticationConsumerService authConsumer
@inject CommunicationResourceConsumer.IResourceConsumerService resourceConsumer

<h1>Service Status</h1>

<h3>Features</h3>

@if (features == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Version</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feature in features)
            {
                <tr>
                    <td>@feature.DisplayName</td>
                    <td>@feature.VersionText</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private SharedBase.Device.FeatureDefinitionExtended[] features;
    private bool connectionState = false;
    private CommunicationBase.ConnectionConfiguration connectionConfiguration;

    protected override async Task OnInitializedAsync()
