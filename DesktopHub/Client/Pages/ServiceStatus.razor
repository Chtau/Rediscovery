            features = args.ToArray();
        };

        var reply = greetingConsumer.GreetHost("192.168.1.100", 44341, new SharedBase.Connection.GreetingDeviceMessage
        {
            DeviceIdentifier = "DesktopHub",
            DeviceName = "A",
            DeviceType = "A",
            Idiom = "A",
            Manufacturer = "A",
            Model = "A",
            OSVersion = "A",
            Platform = "A"
        });

        if (reply.CanConnect == SharedBase.Connection.Enums.AllowConnect.OK)
        {
            if (authConsumer.Connect("192.168.1.100", 44342, reply.PEM))
            {
                authConsumer.SendWelcome(new SharedBase.Connection.WelcomeDeviceMessage
                {
                    DeviceIdentifier = "DesktopHub"
                }, (result) =>
                {
                    if (result.State == SharedBase.Connection.Enums.ConnectionState.OK)
                    {
                        if (resourceConsumer.Connect("192.168.1.100", 44342, reply.PEM))
                        {
                            resourceConsumer.ListenFeatures(result.Token);
                        }
                    }
                });
            }
        }
