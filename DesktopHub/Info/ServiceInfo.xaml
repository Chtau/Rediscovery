<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="250" Height="150" CanResize="False" WindowStartupLocation="CenterScreen"
        Topmost="True"
        x:Class="DesktopHub.Info.ServiceInfo"
        Title="ServiceInfo">
  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="Connect to this IP Address "/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Name="txtIPAddr" Margin="10, 0" FontWeight="Bold" FontSize="20" Text="{Binding IpAddr}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </StackPanel>
  </Grid>
</Window>
