<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DesktopHub.Features.FeaturesControl">
  <Grid RowDefinitions="*, Auto">
    <ListBox Grid.Row="0" Items="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="10,0" Text="{Binding DisplayName}" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0" Text="{Binding Version}" TextAlignment="Center" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
