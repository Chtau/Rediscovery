<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DesktopHub.Features.Firewall.FirewallControl">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ListBox Grid.Row="0" Items="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10, 5">
            <CheckBox Margin="10,0" IsChecked="{Binding RuleSet}" IsEnabled="False"></CheckBox>
            <Button Command="{Binding $parent[UserControl].DataContext.TrySetFW}" CommandParameter="{Binding .}">Create Rule</Button>
            <TextBlock Margin="10,0" VerticalAlignment="Center" Text="{Binding RuleName}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
