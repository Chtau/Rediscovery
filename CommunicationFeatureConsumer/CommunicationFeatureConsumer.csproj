<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.12.2" />
    <PackageReference Include="Grpc.Core" Version="2.29.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.29.0" />
    <PackageReference Include="Grpc.Tools" Version="2.29.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Proto\featureexchange.proto" GrpcServices="Client" Link="Protos\featureexchange.proto" />
    <Protobuf Include="..\Proto\shared.proto" GrpcServices="Client" Link="Protos\shared.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunicationBase\CommunicationBase.csproj" />
    <ProjectReference Include="..\PluginFeature\PluginFeature.csproj" />
  </ItemGroup>

</Project>
